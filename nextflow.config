manifest {
    name            = 'ckangas2/deseqinator'
    author          = 'Chase Kangas'
    homePage        = 'https://github.com/ckangas2/deseqinator'
    description     = 'Bulk RNA-seq of virus infection: fastp, STAR, featureCounts, DESeq2, fgsea, with checks for the failures that do not raise errors'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    // input
    input                   = null      // samplesheet CSV
    contrasts               = null      // contrasts CSV: id,cell_line,reference,target

    // reference: build ...
    host_fasta              = null
    host_gtf                = null      // also used by featureCounts and for gene symbols
    viral_fasta             = null
    sjdb_overhang           = 100
    // ... or reuse
    star_index              = null
    viral_contigs           = null      // viral_contigs.txt from the same build

    // trimming
    fastp_args              = ''

    // strandedness: auto infers from STAR GeneCounts and stops if unclear
    strandedness            = 'auto'    // auto | unstranded | forward | reverse
    strand_threshold        = 0.8

    // gates
    min_assigned_frac       = 0.3
    mock_conditions         = 'Mock'    // comma-separated; must carry no virus
    max_mock_viral_frac     = 0.001
    min_infected_viral_frac = 0.001

    // differential expression
    min_replicates          = 3
    min_count               = 10
    fdr                     = 0.05
    lfc_threshold           = 1
    label_swaps             = true
    seed                    = 42

    // gene sets
    gene_sets               = 'msigdb:H'   // msigdb:<collection>, or a .gmt path
    fgsea_min_size          = 15
    fgsea_max_size          = 500
    fgsea_min_coverage      = 0.7
    fgsea_max_null_hits     = 2

    // optional: authors' deposited count matrix, for sample-swap detection
    deposited_counts        = null
    reconcile_min_rho       = 0.9

    // output
    outdir                  = 'results'
    publish_dir_mode        = 'copy'
    save_bam                = false
    save_reference          = false
    skip_multiqc            = false

    // resources: hard ceilings for any single task
    max_cpus                = 16
    max_memory              = 64.GB
    max_time                = 24.h

    help                    = false
}

process {
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]
    container = 'ghcr.io/ckangas2/deseqinator:0.1.0'

    withLabel: process_single     { cpus = 1;  memory = { 2.GB  * task.attempt }; time = 1.h }
    withLabel: process_low        { cpus = 2;  memory = { 4.GB  * task.attempt }; time = 2.h }
    withLabel: process_medium     { cpus = 6;  memory = { 12.GB * task.attempt }; time = 4.h }
    withLabel: process_deseq2     { cpus = 1;  memory = { 8.GB  * task.attempt }; time = 2.h }
    // Human GRCh38 genomeGenerate needs ~32 GB.
    withLabel: process_star_index { cpus = 16; memory = { 64.GB * task.attempt }; time = 6.h }
    withLabel: process_star_align { cpus = 12; memory = { 40.GB * task.attempt }; time = 4.h }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2
}

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        apptainer.enabled   = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        singularity.enabled  = false
        conda.enabled        = false
    }
    conda {
        conda.enabled       = true
        process.conda       = "${projectDir}/environment.yml"
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }
    test      { includeConfig 'conf/test.config' }
    gse147507 { includeConfig 'conf/gse147507.config' }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }
