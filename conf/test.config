/*
 * Minutes-scale end-to-end run on synthetic data in tests/data/.
 *
 *   nextflow run ckangas2/deseqinator -profile test,docker
 *
 * One host (200 genes on 2 chromosomes, GENCODE-style versioned IDs) and a
 * 5 kb virus. Nine single-end, reverse-stranded libraries:
 *   lineA  Mock x3, SARS-CoV-2 x3     the contrast
 *   lineA  SARS-CoV-2_Rux x1          a third arm that must stay out of it
 *   lineB  Mock x1, SARS-CoV-2 x1     a second cell line that must not be pooled
 * 40 genes are planted as DE (20 up, 20 down, 4-fold). Infected libraries
 * are ~20% viral. Three gene sets: one built on the up genes, one on the
 * down genes, one on unchanged genes. tests/check_test_results.py asserts
 * that each comes back as planted.
 */
params {
    input                   = "${projectDir}/tests/data/samplesheet.csv"
    contrasts               = "${projectDir}/tests/data/contrasts.csv"
    host_fasta              = "${projectDir}/tests/data/host.fa.gz"
    host_gtf                = "${projectDir}/tests/data/host.gtf.gz"
    viral_fasta             = "${projectDir}/tests/data/virus.fa.gz"
    deposited_counts        = "${projectDir}/tests/data/deposited_counts.tsv"
    sjdb_overhang           = 74

    gene_sets               = "${projectDir}/tests/data/test_hallmarks.gmt"
    fgsea_min_size          = 10
    min_infected_viral_frac = 0.05
    // the 200-gene toy transcriptome correlates less tightly than a real one
    reconcile_min_rho       = 0.8

    max_cpus                = 2
    max_memory              = 6.GB
    max_time                = 1.h
}

process {
    withLabel: process_star_index { cpus = 2; memory = 4.GB }
    withLabel: process_star_align { cpus = 2; memory = 4.GB }
    withLabel: process_medium     { cpus = 2; memory = 2.GB }
    withLabel: process_deseq2     { cpus = 1; memory = 2.GB }
    withLabel: process_low        { cpus = 1; memory = 2.GB }
}
