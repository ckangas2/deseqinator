/*
 * GSE147507 (Blanco-Melo et al., Cell 2020): SARS-CoV-2 vs mock in Calu-3
 * and in A549 transduced with ACE2, independent triplicates, Illumina
 * NextSeq 500. Library layout comes from ENA; fetch_runs.sh writes the
 * samplesheet either way.
 *
 *   bash scripts/fetch_reference.sh       # GRCh38, GENCODE v44, SARS-CoV-2, deposited counts
 *   bash scripts/fetch_runs.sh            # writes samplesheet.csv
 *   nextflow run . -profile gse147507,docker
 *
 * The contrasts are per cell line. The A549-ACE2 series also holds
 * Ruxolitinib-treated samples; fetch_runs.sh does not download them, and
 * the contrast would exclude them anyway.
 */
params {
    input            = "${projectDir}/samplesheet.csv"
    contrasts        = "${projectDir}/assets/contrasts_gse147507.csv"
    host_fasta       = "${projectDir}/reference/GRCh38.primary_assembly.genome.fa.gz"
    host_gtf         = "${projectDir}/reference/gencode.v44.primary_assembly.annotation.gtf.gz"
    viral_fasta      = "${projectDir}/reference/SARS-CoV-2_USA-WA1-2020.fa"
    deposited_counts = "${projectDir}/reference/GSE147507_RawReadCounts_Human.tsv.gz"
    mock_conditions  = 'Mock'
    gene_sets        = 'msigdb:H'
}
